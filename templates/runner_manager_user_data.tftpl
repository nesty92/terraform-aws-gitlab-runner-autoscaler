#!/bin/bash -e

# Install additional programs needed by the scripts
for i in {1..7}
do
    echo "Attempt: ---- " $i
    yum install -y jq && break || sleep 60
done

%{ if ecr_credential_helper ~}
# Sign pulls from this account's ECR with the Manager's role
amazon-linux-extras enable docker
for i in {1..7}
do
    echo "Attempt: ---- " $i
    yum install -y amazon-ecr-credential-helper && break || sleep 60
done

%{ endif ~}
# Install gitlab-runner if not installed
if ! ( rpm -q gitlab-runner >/dev/null )
then
    curl --fail --retry 6 -L https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.rpm.sh | bash
    yum install gitlab-runner-${gitlab_runner_version} -y
fi

# Install fleeting-plugin-aws if not installed
if ! ( which fleeting-plugin-aws >/dev/null )
then
    curl --fail --retry 6 -L "https://gitlab.com/gitlab-org/fleeting/plugins/aws/-/releases/${fleeting_plugin_aws_version}/downloads/fleeting-plugin-aws-linux-amd64" -o /usr/bin/fleeting-plugin-aws
    chmod +x /usr/bin/fleeting-plugin-aws
fi

# Stop the gitlab-runner service until it is configured
systemctl stop gitlab-runner

# Configure the gitlab-runner. The heredoc is quoted so the shell writes the
# config as rendered: a value may name a variable the runner expands for each
# job, such as a vm_isolation image, which an unquoted heredoc would expand to
# nothing here. The tokens go in through sed below, not through the shell.
mkdir -p /etc/gitlab-runner
cat > /etc/gitlab-runner/config.toml <<- 'EOF'

${runners_config}

EOF

%{ for token in runner_tokens ~}

# fetch Runner authentication token from SSM and validate it
token=$(aws ssm get-parameters --names "${token.name}" --with-decryption --region "${token.region}" | jq -r ".Parameters | .[0] | .Value")

valid_token=false
if [[ "$token" != "null" ]]
then
    valid_token_response=$(curl -s -o /dev/null -w "%%{response_code}" --request POST -L "${runners_gitlab_url}/api/v4/runners/verify" --form "token=$token" )
    [[ "$valid_token_response" == "200" ]] && valid_token=true
fi

if [[ "$valid_token" == "false" ]]
then
    echo "Invalid token for runner ${token.name}"
    exit 1
fi

# Replace the token in the config.toml
sed -i.bak s/"${token.name}"/"$token"/g /etc/gitlab-runner/config.toml
%{ endfor ~}
%{ for pool in runner_pools ~}

# Runner pool ${pool.key}: appended to config.toml only once its token checks out
token=$(aws ssm get-parameters --names "${pool.token.name}" --with-decryption --region "${pool.token.region}" | jq -r ".Parameters | .[0] | .Value")

valid_token=false
if [[ "$token" != "null" ]]
then
    valid_token_response=$(curl -s -o /dev/null -w "%%{response_code}" --request POST -L "${runners_gitlab_url}/api/v4/runners/verify" --form "token=$token" )
    [[ "$valid_token_response" == "200" ]] && valid_token=true
fi

if [[ "$valid_token" == "true" ]]
then
cat >> /etc/gitlab-runner/config.toml <<- 'EOF'
${pool.config}
EOF
    sed -i.bak "s/${pool.placeholder}/$token/g" /etc/gitlab-runner/config.toml
%{ if pool.on_invalid_token == "fail" ~}
else
    echo "Invalid token for runner pool ${pool.key}"
    exit 1
%{ else ~}
else
    echo "Invalid token for runner pool ${pool.key}; leaving it out of config.toml"
%{ endif ~}
fi
%{ endfor ~}

%{ if fleetci != null ~}

# fleetci: per-job VM classes (https://github.com/nesty92/fleetci)
fleetci_tmp=$(mktemp -d)
fleetci_base="https://github.com/nesty92/fleetci/releases/download/v${fleetci.version}"
for f in fleetci-linux-amd64 fleeting-plugin-fleetci-linux-amd64 checksums.txt
do
    curl --fail --retry 6 -sSL "$fleetci_base/$f" -o "$fleetci_tmp/$f"
done
(cd "$fleetci_tmp" && grep -E ' (fleetci|fleeting-plugin-fleetci)-linux-amd64$' checksums.txt | sha256sum -c -)
install -m 755 "$fleetci_tmp/fleetci-linux-amd64" /usr/bin/fleetci
install -m 755 "$fleetci_tmp/fleeting-plugin-fleetci-linux-amd64" /usr/bin/fleeting-plugin-fleetci
rm -rf "$fleetci_tmp"

install -d -m 700 /etc/fleetci

# gitlab-runner never starts a dead fleeting plugin again: a watchdog per
# runner restarts gitlab-runner when that runner's plugin has been gone for 30 s
cat > /etc/systemd/system/fleetci-watchdog@.service <<- 'EOF'
[Unit]
Description=Restart gitlab-runner when the fleetci plugin of runner-%i is gone
After=gitlab-runner.service

[Service]
ExecStart=/usr/bin/fleetci watchdog -plugin /usr/bin/fleeting-plugin-fleetci-%i -restart "systemctl restart gitlab-runner"
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF
%{ for runner in fleetci.runners ~}

# fleetci of runner-${runner.key}: its plugin by a name of its own
ln -sf /usr/bin/fleeting-plugin-fleetci /usr/bin/fleeting-plugin-fleetci-${runner.key}
cat > /etc/fleetci/${runner.key}.toml <<- 'EOF'
${runner.toml}
EOF
chmod 600 /etc/fleetci/${runner.key}.toml
%{ if runner.github_token != null ~}
token=$(aws ssm get-parameters --names "${runner.github_token.name}" --with-decryption --region "${runner.github_token.region}" | jq -r ".Parameters | .[0] | .Value")
if [[ "$token" == "null" ]]
then
    echo "fleetci: no GitHub token in ${runner.github_token.name}; runner-${runner.key} runs no GitHub jobs"
else
    (umask 077 && printf '%s' "$token" > /etc/fleetci/${runner.key}-github.token)
fi
%{ endif ~}
# Every class, the GitHub access and config.toml; the result is in this log
AWS_DEFAULT_REGION=${aws_region} fleetci check -config /etc/fleetci/${runner.key}.toml -runner-config /etc/gitlab-runner/config.toml || echo "fleetci check found problems for runner-${runner.key}; see above"
%{ endfor ~}
%{ endif ~}

mkdir -p /etc/systemd/system/gitlab-runner.service.d
# Set the AWS default region to the region of the instance
cat > /etc/systemd/system/gitlab-runner.service.d/override.conf <<- EOF
[Service]
Environment="AWS_DEFAULT_REGION=${aws_region}"
EOF

systemctl daemon-reload
systemctl restart gitlab-runner
systemctl enable gitlab-runner
%{ for runner in try(fleetci.runners, []) ~}
%{ if runner.watchdog ~}
systemctl enable --now fleetci-watchdog@${runner.key}
%{ endif ~}
%{ endfor ~}

# Verify the runner is registered
gitlab-runner verify%{ if enable_ssm_agent }

# Enable SSM Agent
systemctl enable --now amazon-ssm-agent
%{ endif ~}