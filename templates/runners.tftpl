%{~ for config in runners_autoscaling ~}

[[runners]]
    name = "${config.name}"
    url = "${config.url}"
    token = "${config.token}"
    shell = "${config.shell}"
    %{~ if request_concurrency != null ~}
    request_concurrency = ${request_concurrency}
    %{~ endif ~}

    executor = "${config.executor}"
    %{~ if try(config.builds_dir, null) != null ~}
    builds_dir = ${jsonencode(config.builds_dir)}
    %{~ endif ~}
    %{~ if length(config.environment) > 0 ~}
    environment = ${jsonencode(config.environment)}
    %{~ endif ~}

    [runners.feature_flags]
    %{~ for key, value in feature_flags ~}
      ${key} = ${jsonencode(value)}
    %{~ endfor ~}

    %{~ if cache != null ~}
    [runners.cache]
      Type = "s3"
      %{~ if cache.path != "" ~}
      Path = ${jsonencode(cache.path)}
      %{~ endif ~}
      Shared = ${cache.shared}
      MaxUploadedArchiveSize = ${cache.max_uploaded_archive_size}

      [runners.cache.s3]
        BucketName = ${jsonencode(cache.bucket_name)}
        BucketLocation = ${jsonencode(cache.bucket_region)}
        AuthenticationType = "iam"
        %{~ if cache.server_side_encryption != null ~}
        ServerSideEncryption = ${jsonencode(cache.server_side_encryption)}
        %{~ endif ~}
        %{~ if cache.server_side_encryption_key_id != null ~}
        ServerSideEncryptionKeyID = ${jsonencode(cache.server_side_encryption_key_id)}
        %{~ endif ~}
        %{~ if cache.dual_stack != null ~}
        DualStack = ${cache.dual_stack}
        %{~ endif ~}
    %{~ endif ~}

    %{~ if config.docker != null ~}
    [runners.docker]
    %{~ for key, value in config.docker ~}
      ${key} = ${jsonencode(value)}
    %{~ endfor ~}
    %{~ endif ~}

    [runners.autoscaler]
      plugin = "${config.plugin}"

    %{~ for key, value in config.autoscaler ~}
      ${key} = ${jsonencode(value)}
    %{~ endfor ~}

      [runners.autoscaler.plugin_config]
      %{~ for key, value in config.plugin_config ~}
        ${key} = ${jsonencode(value)}
      %{~ endfor ~}

      [runners.autoscaler.connector_config]
      %{~ for key, value in config.connector_config ~}
        ${key} = ${jsonencode(value)}
      %{~ endfor ~}

    %{~ if try(config.vm_isolation, null) != null ~}
      [runners.autoscaler.vm_isolation]
      %{~ for key, value in config.vm_isolation.settings ~}
        ${key} = ${jsonencode(value)}
      %{~ endfor ~}

        [runners.autoscaler.vm_isolation.connector_config]
        %{~ for key, value in config.vm_isolation.connector_config ~}
          ${key} = ${jsonencode(value)}
        %{~ endfor ~}
    %{~ endif ~}

    %{~ for index, policy in config.policy ~}
      [[runners.autoscaler.policy]]
      %{~ for key, value in policy ~}
        ${key} = ${jsonencode(value)}
      %{~ endfor ~}
    %{~ endfor ~}
%{~ endfor ~}
